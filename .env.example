# Database
DATABASE_URL="postgresql://investor_crm:localdev@localhost:5432/investor_crm"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production"
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Backend
BACKEND_PORT=4000
BACKEND_URL="http://localhost:4000"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Enrichment Provider (generic — configure for your authorized provider)
ENRICHMENT_PROVIDER_NAME="mock"
ENRICHMENT_PROVIDER_API_KEY=""
ENRICHMENT_PROVIDER_BASE_URL=""

# Messaging Provider (stub by default)
MESSAGING_PROVIDER_NAME="stub"
MESSAGING_PROVIDER_API_KEY=""
MESSAGING_PROVIDER_BASE_URL=""

# File uploads
UPLOAD_DIR="./uploads"
MAX_CSV_ROWS=200000
